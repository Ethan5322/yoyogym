# dependencies
node_modules/

# build output
dist/
.vercel/

# env — NEVER commit secrets (spec: keys via env vars only)
.env
.env.local
.env.*.local

# logs
*.log
npm-debug.log*

# editor / OS
.DS_Store
.vscode/
.idea/

memory/

# Obsidian second brain: the NOTES in vault/ are committed (project knowledge).
# The app state is not — 29MB of vendored plugin code, machine-specific window
# layout, and plugin data.json files (remotely-save holds cloud-sync credentials).
.obsidian/

# Smart Connections private embeddings index (~13MB, machine-local, regenerable)
.smart-env/

# Graphify generated output — derived from vault/ + source, regenerate with:
#   graphify . --obsidian
graphify-out/
